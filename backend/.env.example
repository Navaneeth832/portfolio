# ──────────────────────────────────────────────
# Portfolio Backend — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────

# ── Server ──────────────────────────────────
PORT=5000

# ── Email (Nodemailer via Gmail SMTP) ────────
# Use a Gmail App Password, NOT your real password.
# Enable 2FA on your Google account first, then:
# Google Account → Security → App Passwords → Create
GMAIL_USER=your_email
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ── GitHub GraphQL API ───────────────────────
# Create a Personal Access Token (classic) at:
# https://github.com/settings/tokens
# Required scopes: read:user
GITHUB_TOKEN=your_github_personal_access_token_here

# ── LeetCode ─────────────────────────────────
# No auth needed — proxied through backend to avoid CORS.
LEETCODE_USERNAME=your_username
