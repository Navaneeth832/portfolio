# ──────────────────────────────────────────────
# Portfolio Backend — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────

# ── Server ──────────────────────────────────
PORT=5000

# ── Email (Resend API) ───────────────────────
# Get an API Key from your Resend dashboard: https://resend.com
RESEND_API_KEY=re_your_api_key_here

# The verified domain email address that sends the message
# e.g., onboarding@resend.dev (for testing) or mail@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# The email address where you want to receive the messages
RESEND_TO_EMAIL=your_personal_email@example.com

# ── GitHub GraphQL API ───────────────────────
# Create a Personal Access Token (classic) at:
# https://github.com/settings/tokens
# Required scopes: read:user
GITHUB_TOKEN=your_github_personal_access_token_here

# ── LeetCode ─────────────────────────────────
# No auth needed — proxied through backend to avoid CORS.
LEETCODE_USERNAME=your_username
